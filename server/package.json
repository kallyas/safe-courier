{
  "name": "safe-courier-api",
  "version": "2.0.0",
  "description": "Modern courier delivery service API with secure backend.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test mocha --recursive src/server/test/**/*.test.js --exit",
    "test:coverage": "NODE_ENV=test c8 mocha --reporter spec --reporter html --reporter json src/server/test/**/*.test.js --exit",
    "test:auth": "NODE_ENV=test mocha src/server/test/auth.test.js",
    "test:user": "NODE_ENV=test mocha src/server/test/user.test.js",
    "test:parcel": "NODE_ENV=test mocha src/server/test/parcel.test.js",
    "test:search": "NODE_ENV=test mocha src/server/test/search.test.js",
    "test:system": "NODE_ENV=test mocha src/server/test/system.test.js",
    "test:health": "NODE_ENV=test mocha src/server/test/health.test.js",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.js'",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kallyas/safe-courier.git"
  },
  "keywords": [
    "courier",
    "delivery",
    "logistics",
    "tracking",
    "api",
    "express",
    "mongodb"
  ],
  "authors": [
    "Tumuhirwe Iden"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kallyas/safe-courier/issues"
  },
  "homepage": "https://github.com/kallyas/safe-courier#readme",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "nanoid": "^5.1.5",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "chai-http": "^5.1.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "mocha": "^11.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
